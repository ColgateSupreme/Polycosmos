            { Id = "GhostAdminDesk" }
            { Description = "{#ItalicFormat}{$TempTextData.APPrefix}{#PreviousFormat}{#BoldFormatGraft}{$TempTextData.HintText}{#PreviousFormat}\n{$Keywords.NewSystem}: Give the {#BoldFormatGraft}House Contractor {#PreviousFormat}a break {#ItalicFormat}(and new jobs...){#PreviousFormat}" }

