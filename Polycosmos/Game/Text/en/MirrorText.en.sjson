            { Id = "BreakableValue1" }
            { Description = "{#ItalicFormat}{$TempTextData.APPrefix}{#PreviousFormat}{#BoldFormatGraft}{$TempTextData.HintText}{#PreviousFormat}\n{$Keywords.RunUpgrade}: Chambers may contain urns with {#AltUpgradeFormat}5{#PreviousFormat}{!Icons.Currency_Small}." }

